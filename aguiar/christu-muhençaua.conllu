# text_orig = Ixé xa baptisari iné Paia rera upé, Tuhïra ïuïre, Espiritu-Santu ïuïri.
# text_source = p. 59
# text_por = Eu te baptiso em nome do Padre, e do Filho, e do Espirito-Santo.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Mira u-iucena ramé ï acángua arpe, uhinbin u-icû cuhïri-ten hïnhïngaita.
# text_source = p. 61
# text_por = Quando se derrama a agua sobre a cabeça, vae-se dizendo, ao mesmo tempo, as palavras.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Mahã u-umunhan arama uahá, u-manú ramé.
# text_source = p. 61
# text_por = O que se deve fazer, quando se está para morrer

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Apgáua ô cunhan cerucana, u-mahácï reté ramé, u-cenhôi cari curi Pahí iu-mumêhun arama, iuúca Tupana ïuïri.
# text_source = p. 61
# text_por = O homem ou mulher já baptisado, quando estiver muito doente, fará chamar o Padre para confessar-se e receber a communhão.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = 'Tiramé ahiqué Pahí, iururéruré curi Tupana çupé, cetá hï, u-perduari putari arama i cecupuxi upãin catú.
# text_source = p. 61
# text_por = Se não houver Padre, deverá pedir e rogar a Deus, muitas vezes, se digne perdoar todos os seus peccados.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = U-hinhin curi cetá hï, - Angaçaciçáua, amú iumunhençáua ïuïri;
# text_source = p. 61
# text_por = Dirá muitas vezes o Acto de Contrição, e outras orações adequadas

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = u-cenôi curi mupui Jesus rêra.
# text_source = p. 61
# text_por = invocando amiudadas vezes o nome de Jesus.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Iu-mumehun arama, inti çaru curi u-maú putari ramé.
# text_source = p. 61
# text_por = Para confessar-se, não esperará que já esteja para morrer.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Icuhiri-pá renoné uatari-reté uïri mahacïuêra çupè iandi u-maïnû catù arama Sacramentu.
# text_source = p. 61
# text_por = Antes d'agonia, tambem é mui necessario ao doente o Sacramento da Extrema-Uncção.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Quá-iaué, Tupana pïtümú irumo, iáquau iá-iupiri Iuáca kïtï, iamanú ramè.
# text_source = p. 61
# text_por = Assim, com a graça de Deus, podemos subir para o Ceu, quando morrermos.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Upãin mahã munhançaua
# text_source = p. 63
# text_por = Creação do mundo

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = (A)IRA IEPÉ
# text_source = p. 63
# text_por = Primeiro dia

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Iupïrungáua ramé Tupana u-munhan iuaca ïhnï ïuïri.
# text_source = p. 63
# text_por = No principio creou Deus o Ceu e a terra.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = ïuhi 'ti-pau, 'tirain u-ricú mahan-mahan, pïtuna-pau u-pãin rupi, Tupana pêiuçáua iu-reracô ï-aïtá arpe.
# text_source = p. 63
# text_por = A terra estava vasia, ainda não tinha cousa alguma, em toda a parte as trevas; o espirito de Deus era levado sobre as aguas.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = U-hinhin Tupana:
# text_source = p. 63
# text_por = Disse Deus:

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = - Iu-munhan candêa; candêa iu-munhan.
# text_source = p. 63
# text_por = - Faça-se a luz; e a luz foi feita.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Tupana u-xipiá candêa catú uahá:
# text_source = p. 63
# text_por = Deus viu que aluz era bôa;

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = u-muhin candêa pïtuna çui.
# text_source = p. 63
# text_por = dividiu a luz das trevas.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Tupana u-mucera candêa çupè ara, amú çupé pïtuna.
# text_source = p. 63
# text_por = Deus chamou a luz dia e as trevas noite.

# sent_id = Aguiar1898:x:x:x:
# text = TODO
# text_orig = Caruca coema ïuïri çui iu-munhan ara iepé.
# text_source = p. 63
# text_por = Da tarde e da manhã se fez o primeiro dia.

